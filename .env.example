# ---------------------------------------------------------------------------
# HostBabyShower platform — environment variables
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it is already git-ignored).
#
# Supabase and Twilio credentials below are shared across every event on
# this platform (all events use the same database and the same Twilio
# sending number). Each event only needs its OWN 4-digit host code — see
# HOST_ACCESS_CODE_<SLUG> near the bottom.
# ---------------------------------------------------------------------------

# --- Supabase (server-side only — do NOT prefix these with NEXT_PUBLIC_) ---
# TODO — Connect Supabase and add:
# Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings → API → Project API keys → service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Twilio (server-side only) ---
# TODO — Connect Twilio account and add:
# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# A Twilio phone number capable of sending SMS, in E.164 format
TWILIO_PHONE_NUMBER=+15555550123

# --- Site URL (used to build invitation links sent via SMS and page metadata) ---
# The production domain for this platform is https://hostbabyshower.com
# For local development, override this in your own .env.local with:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://hostbabyshower.com

# --- Per-event host access codes ---
# Every event needs its own private 4-digit code, named
# HOST_ACCESS_CODE_<SLUG_IN_SCREAMING_SNAKE_CASE>. Adding a brand-new event
# client is just: 1) add it to src/lib/events.ts, 2) add its code here.
# This is a PLACEHOLDER for the seed event — set the real code in .env.local.
HOST_ACCESS_CODE_WE_CAN_BEARLY_WAIT=1234
# A future client, e.g. slug "baby-smith", would add:
# HOST_ACCESS_CODE_BABY_SMITH=5678

# Random secret used to sign every event's host session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
